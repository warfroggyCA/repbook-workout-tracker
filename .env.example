# --- Database ---
# Production / Vercel: Neon Postgres connection string (postgres://...)
# Local dev: leave unset to use an embedded PGlite database stored in .pglite/
DATABASE_URL=

# --- Auth (Auth.js v5) ---
# Generate with: npx auth secret
AUTH_SECRET=
# GitHub OAuth app credentials (optional in local dev; dev-login is available)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated list of emails allowed to sign in (single-user app)
ALLOWED_EMAILS=owner@example.com
# Vercel Preview only: one-click login for the separately provisioned public
# preview project and its disposable Neon database. Production and ordinary
# local development leave this unset.
PREVIEW_PUBLIC_LOGIN=

# --- AI provider (optional — the tracker works fully without it) ---
# Set ONE of these; Anthropic wins if both are set. Default parsing models:
# claude-sonnet-5 (Anthropic) / gpt-5.4-mini (OpenAI); override with AI_PARSE_MODEL.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Development only: canned AI responses for local UI testing (ignored in production)
AI_FAKE=

# --- Encrypted snapshots ---
# Vercel injects this when a private Blob store is connected.
BLOB_READ_WRITE_TOKEN=
# Current write key version. Keep older versioned keys available so existing
# immutable snapshots remain decryptable after key rotation.
SNAPSHOT_ENCRYPTION_KEY_VERSION=v1
# 32 random bytes encoded as base64 (for example: openssl rand -base64 32).
SNAPSHOT_ENCRYPTION_KEY_V1=
# Development only: separate local object directory used instead of Vercel Blob.
SNAPSHOT_LOCAL_DIR=

# --- Production maintenance ---
# Shared bearer secret accepted by the application's protected maintenance routes.
MAINTENANCE_SECRET=
