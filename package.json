{
  "name": "repbook-workout-tracker",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/run-unit-tests.mjs",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ci": "vitest run --coverage --exclude tests/unit/performance-budgets-db.test.ts",
    "test:performance:isolated": "vitest run tests/unit/performance-budgets-db.test.ts --maxWorkers=1 --no-file-parallelism",
    "test:selection": "node scripts/check-test-selection.mjs",
    "ci:browser-groups:check": "node scripts/check-production-browser-groups.mjs",
    "test:e2e": "playwright test",
    "test:e2e:pain-hold": "playwright test --config=playwright.pain-hold-notice.config.ts",
    "test:e2e:phase0": "playwright test --config=playwright.phase0.config.ts",
    "test:e2e:phase1": "playwright test --config=playwright.phase1.config.ts",
    "test:e2e:live-workout-iphone": "playwright test --config=playwright.live-workout-iphone.config.ts",
    "test:e2e:program-editor": "playwright test --config=playwright.program-editor.config.ts",
    "test:e2e:program-editor-cross-browser": "playwright test --config=playwright.program-editor-cross-browser.config.ts",
    "test:e2e:program-editor-disabled": "playwright test --config=playwright.program-editor-disabled.config.ts",
    "test:e2e:program-editor-review-recovery": "playwright test --config=playwright.program-editor-review-recovery.config.ts",
    "test:e2e:production-headers": "playwright test --config=playwright.production.config.ts",
    "test:e2e:failed-set-recovery": "playwright test --config=playwright.failed-set-recovery.config.ts",
    "test:e2e:plate-machine-guidance": "playwright test --config=playwright.plate-machine-guidance.config.ts",
    "test:e2e:replacement-mobile": "playwright test --config=playwright.replacement-mobile.config.ts",
    "test:e2e:current-action": "playwright test --config=playwright.stage3.config.ts && playwright test --config=playwright.stage3-mobile.config.ts",
    "test:e2e:compact-timer": "playwright test --config=playwright.stage5.config.ts",
    "test:e2e:superset-prep": "playwright test --config=playwright.superset-prep.config.ts",
    "test:e2e:active-workout-add-exercise": "playwright test --config=playwright.active-workout-add-exercise.config.ts",
    "test:e2e:v2-t01": "playwright test --config=playwright.v2-t01.config.ts",
    "test:e2e:v2-t02": "playwright test --config=playwright.v2-t02.config.ts",
    "test:e2e:v2-t03": "playwright test --config=playwright.v2-t03.config.ts",
    "test:e2e:v2-t04": "playwright test --config=playwright.v2-t04.config.ts",
    "test:e2e:v2-t05": "playwright test --config=playwright.v2-t05.config.ts",
    "test:e2e:v2-t06": "playwright test --config=playwright.v2-t06.config.ts --project=desktop-chromium && V2_T06_PORT=3136 playwright test --config=playwright.v2-t06.config.ts --project=narrow-mobile-webkit",
    "test:e2e:v2-u01": "playwright test --config=playwright.v2-u01.config.ts",
    "test:e2e:post-v2-p1-timing": "playwright test --config=playwright.post-v2-p1-timing.config.ts",
    "test:e2e:v2-u02": "playwright test --config=playwright.v2-u02.config.ts",
    "test:e2e:v2-u03": "playwright test --config=playwright.v2-u03.config.ts",
    "test:e2e:v2-gauntlet-a": "playwright test --config=playwright.v2-gauntlet-a.config.ts && playwright test --config=playwright.v2-gauntlet-a-warmup.config.ts",
    "test:e2e:v2-h01": "playwright test --config=playwright.v2-h01.config.ts",
    "test:e2e:v2-h02": "playwright test --config=playwright.v2-h02.config.ts",
    "test:e2e:v2-h03": "playwright test --config=playwright.v2-h03.config.ts --project=desktop-chromium && V2_H03_PORT=3144 playwright test --config=playwright.v2-h03.config.ts --project=narrow-mobile-webkit",
    "test:e2e:v2-h04": "playwright test --config=playwright.v2-h04.config.ts --project=desktop-chromium && V2_H04_PORT=3146 playwright test --config=playwright.v2-h04.config.ts --project=narrow-mobile-webkit",
    "test:e2e:v2-h05": "playwright test --config=playwright.v2-h05.config.ts --project=desktop-chromium && V2_H05_PORT=3148 playwright test --config=playwright.v2-h05.config.ts --project=narrow-mobile-webkit",
    "test:e2e:v2-gauntlet-b": "playwright test --config=playwright.v2-gauntlet-b.config.ts --project=desktop-chromium && V2_GAUNTLET_B_PORT=3150 playwright test --config=playwright.v2-gauntlet-b.config.ts --project=mobile-reference-chromium && V2_GAUNTLET_B_PORT=3151 playwright test --config=playwright.v2-gauntlet-b.config.ts --project=narrow-mobile-webkit",
    "test:e2e:v2-a01": "playwright test --config=playwright.v2-a01.config.ts --project=desktop-chromium && V2_A01_PORT=3153 playwright test --config=playwright.v2-a01.config.ts --project=narrow-mobile-webkit",
    "test:e2e:v2-a02": "playwright test --config=playwright.v2-a02.config.ts --project=desktop-chromium && V2_A02_PORT=3155 playwright test --config=playwright.v2-a02.config.ts --project=narrow-mobile-webkit",
    "test:e2e:v2-a03": "playwright test --config=playwright.v2-a03.config.ts --project=desktop-chromium && V2_A03_PORT=3157 playwright test --config=playwright.v2-a03.config.ts --project=narrow-mobile-webkit",
    "test:e2e:v2-a04": "playwright test --config=playwright.v2-a04.config.ts --project=desktop-chromium && V2_A04_PORT=3159 playwright test --config=playwright.v2-a04.config.ts --project=narrow-mobile-webkit",
    "test:e2e:v2-a05": "playwright test --config=playwright.v2-a05.config.ts --project=desktop-chromium && V2_A05_PORT=3161 playwright test --config=playwright.v2-a05.config.ts --project=narrow-mobile-webkit",
    "test:e2e:v2-d02": "playwright test --config=playwright.v2-d02.config.ts --project=desktop-chromium && V2_D02_PORT=3163 playwright test --config=playwright.v2-d02.config.ts --project=narrow-mobile-webkit",
    "test:e2e:v2-r01": "playwright test --config=playwright.v2-r01.config.ts --project=desktop-chromium && V2_R01_PORT=3171 playwright test --config=playwright.v2-r01.config.ts --project=narrow-mobile-webkit",
    "test:e2e:pii01": "playwright test --config=playwright.pii01.config.ts",
    "test:e2e:pii01b": "playwright test --config=playwright.pii01b.config.ts",
    "study:physical-device-server": "E2E_HOSTNAME=0.0.0.0 E2E_PORT=3128 node scripts/run-e2e-server.mjs --production",
    "test:e2e:ba:chrome": "env BA_BROWSER=chromium playwright test --config=playwright.ba-workout.config.ts",
    "test:e2e:ba:webkit": "env BA_BROWSER=webkit playwright test --config=playwright.ba-workout.config.ts",
    "test:e2e:ba:observations": "env BA_BROWSER=chromium playwright test --config=playwright.ba-workout.config.ts tests/ba/ba-observation-classification.spec.ts",
    "test:e2e:ba:routine-change": "playwright test --config=playwright.ba-routine-change.config.ts",
    "test:e2e:ba:calendar": "playwright test --config=playwright.ba-calendar.config.ts",
    "test:e2e:history-calendar": "playwright test --config=playwright.history-calendar.config.ts",
    "test:e2e:history-workspace": "playwright test --config=playwright.history-workspace.config.ts",
    "test:e2e:ba:routine-failure": "playwright test --config=playwright.ba-routine-failure.config.ts",
    "test:integration:postgres": "vitest run --config vitest.postgres.config.ts",
    "test:watch": "vitest",
    "docs:check": "node scripts/check-documentation-links.mjs",
    "audit:check": "node scripts/check-dependency-audit.mjs",
    "db:disposable": "node scripts/create-disposable-db.mjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:neon-atomic": "node scripts/migrate-neon-atomic.mjs",
    "db:seed": "tsx src/db/seed/run.ts",
    "db:verify": "node scripts/verify-migrations.mjs",
    "db:verify-production-upgrade": "vitest run tests/unit/production-schema-upgrade.test.ts --maxWorkers=1",
    "db:verify:program-editor-neon": "node scripts/verify-program-editor-neon.mjs",
    "verify:core-loop-neon": "node --conditions=react-server --import tsx scripts/verify-core-loop-neon.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.8",
    "@ai-sdk/openai": "^4.0.9",
    "@base-ui/react": "^1.6.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.6.1",
    "ai": "^7.0.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.2.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.23.0",
    "next": "16.2.11",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "js-yaml": "^4.3.1",
    "pg": "^8.22.0",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.17",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
